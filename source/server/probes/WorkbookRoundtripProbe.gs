// Own synthetic workbook only. No production IDs and no public endpoint.
const HDND_FIXTURE_XLSX_B64='';
function testExcelWorkbookRoundtrip(){
 const mime='application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
 const token=ScriptApp.getOAuthToken();let id='';
 const original=Utilities.newBlob(Utilities.base64Decode(HDND_FIXTURE_XLSX_B64),mime,'HDND_TEST_ONLY.xlsx');
 function call(url,method,payload,etag){const headers={Authorization:'Bearer '+token};if(etag)headers['If-Match']=etag;return UrlFetchApp.fetch(url,{method,headers,contentType:mime,payload,muteHttpExceptions:true});}
 function unpack(blob){const parts=Utilities.unzip(blob.copyBlob().setContentType('application/zip'));const map={};for(const part of parts){if(map[part.getName()])throw new Error('Duplicate ZIP part');map[part.getName()]=part;}return map;}
 function hash(blob){return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,blob.getBytes()).map(b=>(b&255).toString(16).padStart(2,'0')).join('');}
 try{
  const created=call('https://www.googleapis.com/upload/drive/v2/files?uploadType=media&convert=false&fields=id,etag,mimeType','post',original);
  if(created.getResponseCode()!==200&&created.getResponseCode()!==201)throw new Error('Create fake workbook HTTP '+created.getResponseCode());
  const initial=JSON.parse(created.getContentText());id=initial.id;
  if(!id||!initial.etag||initial.mimeType!==mime)throw new Error('Fake workbook metadata mismatch');
  const sourceParts=unpack(original);
  const path=HDNDExcelWriteCore.worksheetPath(sourceParts['xl/workbook.xml'].getDataAsString('UTF-8'),sourceParts['xl/_rels/workbook.xml.rels'].getDataAsString('UTF-8'),'Du lieu');
  const strings=HDNDExcelWriteCore.sharedStrings(sourceParts['xl/sharedStrings.xml']?.getDataAsString('UTF-8'));
  const originalXml=sourceParts[path].getDataAsString('UTF-8'),current=HDNDExcelWriteCore.cells(originalXml,strings);
  const value='Nội dung THỬ & <không phải dữ liệu thật> 😀';
  const patches=HDNDExcelWriteCore.recordPatches(originalXml,strings,[{code:'ID1',baseValues:{content:current.C4.value,note:current.O4?.value||''},changes:{content:value,note:'Ghi chú thử'}}]);
  const edited=HDNDExcelWriteCore.patchWorksheet(originalXml,strings,patches);
  XmlService.parse(edited);
  const updated=Utilities.zip(Object.keys(sourceParts).map(name=>name===path?Utilities.newBlob(edited,'application/xml',name):sourceParts[name]),'HDND_TEST_ONLY.xlsx').setContentType(mime);
  const saved=call('https://www.googleapis.com/upload/drive/v2/files/'+id+'?uploadType=media&convert=false&fields=id,etag,mimeType','put',updated,initial.etag);
  if(saved.getResponseCode()!==200)throw new Error('Fake workbook update HTTP '+saved.getResponseCode());
  const meta=JSON.parse(saved.getContentText());
  const stale=call('https://www.googleapis.com/upload/drive/v2/files/'+id+'?uploadType=media&convert=false&fields=id,etag,mimeType','put',original,initial.etag);
  const read=UrlFetchApp.fetch('https://www.googleapis.com/drive/v2/files/'+id+'?alt=media',{headers:{Authorization:'Bearer '+token},muteHttpExceptions:true});
  if(read.getResponseCode()!==200)throw new Error('Readback fake workbook HTTP '+read.getResponseCode());
  const blob=read.getBlob(),readParts=unpack(blob),readCells=HDNDExcelWriteCore.cells(readParts[path].getDataAsString('UTF-8'),strings);
  const otherPartsPreserved=Object.keys(sourceParts).length===Object.keys(readParts).length&&Object.keys(sourceParts).filter(name=>name!==path).every(name=>readParts[name]&&hash(readParts[name])===hash(sourceParts[name]));
  const otherCellsPreserved=Object.keys(current).filter(ref=>!['C4','O4'].includes(ref)).every(ref=>readCells[ref]?.raw===current[ref].raw);
  const result={testFileId:id,sameFileId:meta.id===id,mimePreserved:meta.mimeType===mime,firstStatus:saved.getResponseCode(),staleStatus:stale.getResponseCode(),blobMatchesUpload:hash(blob)===hash(updated),contentReadBack:readCells.C4?.value===value,noteReadBack:readCells.O4?.value==='Ghi chú thử',otherPartsPreserved,otherCellsPreserved};
  result.pass=result.sameFileId&&result.mimePreserved&&result.staleStatus===412&&result.blobMatchesUpload&&result.contentReadBack&&result.noteReadBack&&result.otherPartsPreserved&&result.otherCellsPreserved;
  console.log(JSON.stringify(result));return result;
 }finally{
  if(id){const cleanup=UrlFetchApp.fetch('https://www.googleapis.com/drive/v2/files/'+id+'/trash',{method:'post',headers:{Authorization:'Bearer '+token},muteHttpExceptions:true});console.log('Own fake workbook moved to Trash: HTTP '+cleanup.getResponseCode());}
 }
}
